{
  "name": "portfolio-claude",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Nabeel Thurakkal's portfolio — Next.js frontend + Go backend + Postgres.",
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && go run ./cmd/server",
    "dev:frontend": "npm run dev --workspace=portfolio-frontend",
    "build": "npm run build:frontend",
    "build:backend": "cd backend && go build -o bin/server ./cmd/server",
    "build:frontend": "npm run build --workspace=portfolio-frontend",
    "start": "concurrently -k -n backend,frontend -c blue,magenta \"npm:start:backend\" \"npm:start:frontend\"",
    "start:backend": "cd backend && ./bin/server",
    "start:frontend": "npm run start --workspace=portfolio-frontend",
    "seed": "cd backend && go run ./cmd/seed",
    "typecheck": "npm run typecheck --workspace=portfolio-frontend",
    "lint": "npm run lint --workspace=portfolio-frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
