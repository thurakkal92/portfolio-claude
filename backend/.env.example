# Postgres
DATABASE_URL=postgres://portfolio:portfolio@localhost:5433/portfolio?sslmode=disable

# HTTP
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,https://thurakkal.com

# Resend (https://resend.com) — leave blank locally to skip sending; submissions are still persisted
RESEND_API_KEY=
CONTACT_FROM=no-reply@thurakkal.com
CONTACT_TO=nabeel.thurakkal92@gmail.com

# Contact form rate limit (per IP per hour)
CONTACT_RATE_LIMIT_PER_HOUR=5

# Migrations + seed run on server startup (set to false in production after first deploy)
RUN_MIGRATIONS=true
SEED_ON_START=true
